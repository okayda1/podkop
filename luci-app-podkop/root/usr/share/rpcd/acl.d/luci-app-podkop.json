{
  "luci-app-podkop": {
    "description": "Grant UCI and RPC access to LuCI app podkop",
    "read": {
      "file": {
        "/etc/init.d/podkop": [
          "exec"
        ],
        "/usr/bin/podkop": [
          "exec"
        ],
        "/etc/podkop-manual.lst": [
          "read"
        ]
      },
      "ubus": {
        "service": [
          "list"
        ]
      },
      "uci": [
        "podkop"
      ]
    },
    "write": {
      "file": {
        "/etc/podkop-manual.lst": [
          "write"
        ],
        "/bin/sh": [
          "exec"
        ],
        "/root/update-blocked-domains.sh": [
          "exec"
        ]
      },
      "uci": [
        "podkop"
      ]
    }
  }
}